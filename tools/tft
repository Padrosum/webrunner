#!/bin/sh

# Adapted from Padrosum/TorforTerminal (MIT License).
# WebRunner runs it against the guest-local Tor SOCKS proxy.
set -eu

UA="Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"

usage() {
  printf '%s\n' \
    'Kullanım:' \
    '  tft <adres>' \
    '  tft -d "arama terimi"'
  exit 2
}

[ "$#" -gt 0 ] || usage

case "$1" in
  -d|--duckduckgo)
    shift
    [ "$#" -gt 0 ] || usage
    query="$(printf '%s' "$*" | sed 's/ /+/g')"
    target="https://html.duckduckgo.com/html/?q=$query"
    ;;
  *)
    target="$1"
    case "$target" in
      http://*|https://*) ;;
      *) target="https://$target" ;;
    esac
    ;;
esac

printf 'Tor üzerinden okunuyor: %s\n' "$target"
torsocks curl --silent --show-error --location --user-agent "$UA" "$target" | w3m -T text/html
